# Copy this file to .env and fill in your actual values.
# .env is gitignored — NEVER commit real secrets.

# HuggingFace Hub
HF_TOKEN=hf_your_token_here
HF_USERNAME=Verm1ion

# Weights & Biases
WANDB_API_KEY=your_wandb_key_here
WANDB_PROJECT=colturk-vdr
WANDB_ENTITY=verm1lion

# Kaggle (if uploading dataset / notebook via API)
KAGGLE_USERNAME=verm1lion
KAGGLE_KEY=your_kaggle_key_here

# Optional: scraping rate-limits (seconds between requests)
SCRAPE_DELAY_SECONDS=2

# Optional: cache directories (defaults shown)
HF_HOME=./hf_cache
TRANSFORMERS_CACHE=./hf_cache/transformers
DATASETS_CACHE=./hf_cache/datasets
